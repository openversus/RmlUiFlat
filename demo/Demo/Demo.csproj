<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NativeBuildDir>$(MSBuildThisFileDirectory)../../native/build/linux/</NativeBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RmlUi.Net.Desktop/RmlUi.Net.Desktop.csproj" />
  </ItemGroup>

  <!-- Linux: static link. The shim, the desktop backend and RmlUi itself go into the executable. Build native/ first
       (see README). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <DirectPInvoke Include="rmlui_c" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui_c_backend.a" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui_c.a" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui.a" />
    <NativeLibrary Include="$(NativeBuildDir)SDL/libSDL3.a" />
    <!-- SDL3 and RmlUi's renderers load X11/Wayland, Vulkan, GL and audio at run time; only these are linked. -->
    <LinkerArg Include="-lfreetype -lstdc++ -ldl -lm -lpthread" />
  </ItemGroup>

  <!-- Windows: rmlui_c.dll loaded at runtime from beside the executable, as the client would load it. Build it with
       cross/build-windows.sh desktop first. -->
  <PropertyGroup>
    <WinDllDir>$(MSBuildThisFileDirectory)../../native/build/win-desktop/</WinDllDir>
    <!-- As in ovs-client: keep PublishAotCrossXWin's xwin cache out of its NuGet folder (restore loops on the
         splat's self-referencing symlink). -->
    <XWinCache Condition="'$(XWinCache)' == ''">$(HOME)/.cache/xwin/</XWinCache>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets `dotnet publish -r win-x64` link on Linux with lld-link and the xwin sysroot; inert for other RIDs. -->
    <PackageReference Include="PublishAotCrossXWin" Version="1.2.0" />
  </ItemGroup>
  <Target Name="CopyRmlUiDll" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Error Condition="!Exists('$(WinDllDir)rmlui_c.dll')" Text="No $(WinDllDir)rmlui_c.dll; run cross/build-windows.sh desktop" />
    <Copy SourceFiles="$(WinDllDir)rmlui_c.dll" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>

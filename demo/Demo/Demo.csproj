<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NativeBuildDir>$(MSBuildThisFileDirectory)../../native/build/linux/</NativeBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RmlUi.Net/RmlUi.Net.csproj" />
  </ItemGroup>

  <!-- Static link: the shim, the desktop backend and RmlUi itself go into the executable. Build native/ first (see README). -->
  <ItemGroup>
    <DirectPInvoke Include="rmlui_c" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui_c_backend.a" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui_c.a" />
    <NativeLibrary Include="$(NativeBuildDir)librmlui.a" />
    <LinkerArg Include="-lfreetype -lX11 -lXext -lGL -lstdc++ -ldl -lm" />
  </ItemGroup>

</Project>

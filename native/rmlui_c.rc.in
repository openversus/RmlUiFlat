// Version resource for rmlui_c.dll; configured by native/CMakeLists.txt from VERSION.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @RMLC_VERSION_COMMAS@
    PRODUCTVERSION @RMLC_VERSION_COMMAS@
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RmlUi with a C API"
            VALUE "FileVersion", "@RMLC_VERSION@"
            VALUE "ProductName", "rmlui_c"
            VALUE "ProductVersion", "@RMLC_VERSION@"
            VALUE "OriginalFilename", "rmlui_c.dll"
            VALUE "LegalCopyright", "Copyright (c) 2026 Christopher Conley. RmlUi copyright (c) the RmlUi team. Portions copyright (c) The FreeType Project (www.freetype.org)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
